{
  "name": "shoveler-cms",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client && node scripts/copy-admin-to-site.mjs",
    "start": "tsx server/src/index.ts",
    "db:generate": "prisma generate --schema=prisma/schema.prisma && node -e \"const fs=require('fs');const p=require('path');const s='server/node_modules';fs.mkdirSync(s+'/@prisma',{recursive:true});fs.mkdirSync(s+'/.prisma',{recursive:true});fs.cpSync('node_modules/@prisma/client',s+'/@prisma/client',{recursive:true});if(fs.existsSync('node_modules/.prisma'))fs.cpSync('node_modules/.prisma',s+'/.prisma',{recursive:true});\"",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "prisma": "^6.5.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2"
  }
}
