# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# SQLite path relative to cms/prisma/ (same as Prisma schema folder).
DATABASE_URL="file:./dev.db"

# REQUIRED in production: random string, 32+ characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-in-production"

# Comma-separated browser origins allowed to call the API with cookies
CLIENT_ORIGIN="http://localhost:5173"
SITE_ORIGIN="https://www.shovelersafari.com"

# Uploads directory (relative to cms/ or absolute)
UPLOAD_DIR="./uploads"

# Behind Cloudflare / nginx set to 1 so rate limits see real client IPs
TRUST_PROXY=0

# Optional: force Secure cookies (auto-on when SITE_ORIGIN is https or NODE_ENV=production)
# COOKIE_SECURE=true

# Local password-reset testing: writes code + link to cms/.dev-reset-link (never logs them)
ALLOW_DEV_RESET_FILE=true

# Default country code when users enter local numbers (Tanzania)
DEFAULT_PHONE_COUNTRY=255

# Optional: override generated seed passwords / admin WhatsApp
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_PHONE=+255783591810
# SEED_EDITOR_PASSWORD=
# SEED_AUTHOR_PASSWORD=

# —— SIMPLEST free email when Resend is unavailable: Gmail SMTP ——
# 1) Open https://myaccount.google.com/security
# 2) Turn on 2-Step Verification
# 3) Search “App passwords” → create one for “Mail”
# 4) Paste the 16-character app password into SMTP_PASS (not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youremail@gmail.com
SMTP_PASS=
SMTP_FROM="Northern Shoveler Adventure <youremail@gmail.com>"

# Optional alternative: https://www.brevo.com (free SMTP) if Gmail is blocked
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Optional: Resend API (if available in your country)
# RESEND_API_KEY=
# RESEND_FROM="Northern Shoveler Adventure <onboarding@resend.dev>"

# —— WhatsApp is NOT free/simple for beginners (skip for now) ——
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
